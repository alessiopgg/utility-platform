{
  "name": "utility-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run prepare:vendor && npm run qa && astro build",
    "preview": "astro preview",
    "qa": "npm run qa:catalog && npm run qa:implementation && npm run qa:release && npm run typecheck:core && npm run test:core",
    "qa:catalog": "node scripts/catalog-audit.mjs",
    "test:core": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "prepare:vendor": "node scripts/copy-vendor.mjs",
    "qa:implementation": "node --experimental-strip-types scripts/implementation-audit.mjs",
    "qa:release": "node scripts/release-audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.0",
    "cronstrue": "3.24.0",
    "exifreader": "4.45.0",
    "heic2any": "0.0.4",
    "marked": "18.0.12",
    "piexifjs": "1.0.6",
    "prettier": "3.9.6",
    "sql-formatter": "15.8.2",
    "turndown": "7.2.4",
    "yaml": "2.9.1",
    "qrcode": "1.5.4",
    "jsbarcode": "3.12.3",
    "@zxing/browser": "0.2.1",
    "@cantoo/pdf-lib": "2.11.0",
    "pdfjs-dist": "6.3.289",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/core": "0.12.10"
  },
  "devDependencies": {
    "typescript": "7.0.0"
  }
}
