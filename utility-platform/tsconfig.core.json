{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/engines/**/*.ts",
    "src/i18n/**/*.ts",
    "src/tools/**/*.ts",
    "src/vendor.d.ts"
  ]
}
