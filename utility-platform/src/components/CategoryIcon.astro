  developer:'<path d="m8.5 7-5 5 5 5M15.5 7l5 5-5 5M13.5 4.5l-3 15"/>',
  encoding:'<path d="M10 3 8 21m8-18-2 18M4 9h16M3 15h16"/>',
  random:'<rect x="4" y="4" width="16" height="16" rx="3.5"/><circle cx="9" cy="9" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="9" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="9" cy="15" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="15" r="1" fill="currentColor" stroke="none"/>',
  color:'<path d="M12 3a9 9 0 1 0 0 18h1.3a1.9 1.9 0 1 0 0-3.8H12a1.7 1.7 0 0 1 0-3.4h2.1A6.9 6.9 0 0 0 21 6.9 3.9 3.9 0 0 0 17.1 3z"/><circle cx="7.8" cy="10" r=".9" fill="currentColor" stroke="none"/><circle cx="10.3" cy="6.8" r=".9" fill="currentColor" stroke="none"/><circle cx="14.3" cy="6.4" r=".9" fill="currentColor" stroke="none"/>',
  image:'<rect x="3.5" y="4" width="17" height="16" rx="2.5"/><circle cx="9" cy="9.5" r="2"/><path d="m5.5 18 5-5 3.2 3.2 2.2-2.2 2.6 4"/>',
