---
<span class:list={['category-icon',`category-icon-${size}`]} aria-hidden="true" data-category={slug}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[slug] ?? icons.web}></svg>
</span>
