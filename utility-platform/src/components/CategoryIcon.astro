  construction:'<path d="M5 19 18.5 5.5M9 7l8 8M4.5 14.5l5 5"/>',
  'creator-calculators':'<path d="M4 8h3.5L9 6h6l1.5 2H20v11H4z"/><circle cx="12" cy="13.5" r="3.3"/>',
