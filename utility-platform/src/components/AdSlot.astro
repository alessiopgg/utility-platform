---
import { ADSENSE_CLIENT, ADSENSE_SLOT } from '../core/site.ts';

interface Props {
  label: string;
  slot?: string;
}

const { label, slot = ADSENSE_SLOT } = Astro.props;
const enabled = Boolean(ADSENSE_CLIENT && slot);
---
{enabled ? (
  <div class="ad-slot ad-slot-live" aria-label={label}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>try{(window.adsbygoogle=window.adsbygoogle||[]).push({});}catch{}</script>
  </div>
) : (
  <div class="ad-slot" aria-label={label} data-ad-disabled>{label}</div>
)}
