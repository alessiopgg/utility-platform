---
import type { LocaleId } from '../core/types.ts';
import { ui } from '../i18n/ui.ts';
import { interactions } from '../i18n/interactions.ts';
import { searchIndexPath } from '../core/routes.ts';
interface Props { locale: LocaleId; }
const { locale } = Astro.props;
const t = ui(locale);
const ix = interactions(locale);
---
<div class="global-search" data-global-search data-index-url={searchIndexPath(locale)} data-empty-label={ix.noSearchResults}>
  <button class="header-search-trigger" type="button" data-search-open aria-haspopup="dialog" aria-controls={`global-search-${locale}`} aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.4-3.4"></path></svg>
    <span>{t.search}</span>
    <kbd aria-hidden="true">/</kbd>
  </button>
  <dialog class="search-dialog" id={`global-search-${locale}`} data-search-dialog aria-label={t.search}>
    <div class="search-dialog-panel">
      <div class="search-dialog-head">
        <div class="search-dialog-input-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.4-3.4"></path></svg>
          <input type="search" placeholder={t.searchPlaceholder} aria-label={t.search} autocomplete="off" data-search-dialog-input />
        </div>
        <button class="icon-btn" type="button" data-search-close aria-label={ix.close}>×</button>
      </div>
      <div class="search-dialog-results" data-search-dialog-results aria-live="polite"></div>
    </div>
  </dialog>
</div>
<script>
  document.querySelectorAll('[data-global-search]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.bound === '1') return;
    root.dataset.bound = '1';
    const openButton = root.querySelector('[data-search-open]');
    const dialog = root.querySelector('[data-search-dialog]');
    const closeButton = root.querySelector('[data-search-close]');
    const input = root.querySelector('[data-search-dialog-input]');
    const results = root.querySelector('[data-search-dialog-results]');
    if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return;
    let index = null;
    let active = -1;
    const normalize = (value) => value.toLocaleLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim();
    const ensureIndex = async () => {
      if (index) return index;
      const response = await fetch(root.dataset.indexUrl || '/search-index.json');
      if (!response.ok) throw new Error('Search index unavailable');
      index = await response.json();
      return index;
    };
    const render = async () => {
      const q = normalize(input.value);
      results.innerHTML = '';
      active = -1;
      if (!q) return;
      try {
        const items = await ensureIndex();
        const ranked = items.map((item) => {
          const name = normalize(item.name || '');
          const category = normalize(item.category || '');
          const haystack = normalize(item.search || `${item.name} ${item.category} ${item.description || ''}`);
          let score = 99;
          if (name.startsWith(q)) score = 0;
          else if (name.includes(q)) score = 1;
          else if (category.startsWith(q)) score = 2;
          else if (category.includes(q)) score = 3;
          else if (haystack.includes(q)) score = 4;
          return {item,score};
        }).filter((entry) => entry.score < 99).sort((a,b) => a.score-b.score || a.item.name.localeCompare(b.item.name)).slice(0,10);
        if (!ranked.length) {
          const empty = document.createElement('p'); empty.className='search-dialog-empty'; empty.textContent=root.dataset.emptyLabel || 'No results'; results.append(empty); return;
        }
        for (const {item} of ranked) {
          const a=document.createElement('a'); a.className='search-dialog-result'; a.href=item.url;
          const main=document.createElement('span'); main.className='search-dialog-result-main';
          const name=document.createElement('strong'); name.textContent=item.name;
          const category=document.createElement('small'); category.textContent=item.category;
          const desc=document.createElement('span'); desc.className='search-dialog-result-desc'; desc.textContent=item.description||'';
          main.append(name,category,desc);
          const arrow=document.createElement('span'); arrow.className='search-dialog-arrow'; arrow.setAttribute('aria-hidden','true'); arrow.textContent='↗';
          a.append(main,arrow); results.append(a);
        }
      } catch {
        const empty=document.createElement('p'); empty.className='search-dialog-empty'; empty.textContent=root.dataset.emptyLabel || 'No results'; results.append(empty);
      }
    };
    const open = async () => { if (!dialog.open) dialog.showModal(); if(openButton instanceof HTMLElement)openButton.setAttribute('aria-expanded','true'); requestAnimationFrame(()=>input.focus()); await ensureIndex().catch(()=>null); };
    openButton?.addEventListener('click', open);
    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close',()=>{if(openButton instanceof HTMLElement)openButton.setAttribute('aria-expanded','false')});
    dialog.addEventListener('click',(event)=>{ if(event.target===dialog) dialog.close(); });
    input.addEventListener('input', render);
    input.addEventListener('keydown',(event)=>{
      const links=Array.from(results.querySelectorAll('a'));
      if(event.key==='ArrowDown'&&links.length){event.preventDefault();active=(active+1)%links.length;links[active]?.focus();}
      if(event.key==='Escape'){dialog.close();}
      if(event.key==='Enter'&&links.length&&input.value.trim()){event.preventDefault();window.location.href=links[0].href;}
    });
    results.addEventListener('keydown',(event)=>{
      if(!(event.target instanceof HTMLAnchorElement))return;
      const links=Array.from(results.querySelectorAll('a'));
      const current=links.indexOf(event.target);
      if(event.key==='ArrowDown'){event.preventDefault();links[(current+1)%links.length]?.focus();}
      if(event.key==='ArrowUp'){event.preventDefault();if(current===0)input.focus();else links[current-1]?.focus();}
      if(event.key==='Escape')dialog.close();
    });
    window.addEventListener('keydown',(event)=>{
      if(event.key!=='/'||event.metaKey||event.ctrlKey||event.altKey||dialog.open)return;
      const activeElement=document.activeElement;
      if(activeElement instanceof HTMLInputElement||activeElement instanceof HTMLTextAreaElement||activeElement instanceof HTMLSelectElement)return;
      event.preventDefault();const hero=document.querySelector('[data-tool-search]');if(hero instanceof HTMLInputElement){hero.focus();}else{open();}
    });
  });
</script>
