---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { LocaleId } from '../core/types.ts';
import { legal } from '../i18n/legal.ts';
import { locales } from '../i18n/config.ts';
import { localePrefix, homePath } from '../core/routes.ts';
import { CONTACT_EMAIL } from '../core/site.ts';
type Kind='privacy'|'terms'|'about'|'contact';
interface Props{locale:LocaleId;kind:Kind}
const {locale,kind}=Astro.props;const t=legal(locale);const title=t[kind];const path=(l:LocaleId)=>`${localePrefix(l)}/${kind}/`.replace('//','/');const localePaths=Object.fromEntries(locales.map(l=>[l,path(l)]));
const intros={privacy:t.privacyIntro,terms:t.termsIntro,about:t.aboutIntro,contact:t.contactIntro};
---
<BaseLayout locale={locale} title={title} description={intros[kind]} canonicalPath={path(locale)} localePaths={localePaths}>
  <div class="container legal-page">
    <nav class="breadcrumb"><a href={homePath(locale)}>←</a><span>{title}</span></nav>
    <h1>{title}</h1><p class="lead">{intros[kind]}</p>
    {kind==='privacy' && <><h2>Local processing</h2><p>{t.localProcessing}</p><h2>Advertising</h2><p>{t.ads}</p><h2>Analytics</h2><p>{t.analytics}</p><h2>Storage</h2><p>{t.storage}</p></>}
    {kind==='terms' && <><h2>Use of the tools</h2><p>{t.use}</p><h2>Accuracy and liability</h2><p>{t.liability}</p><h2>Changes</h2><p>{t.changes}</p></>}
    {kind==='about' && <><p>{t.localProcessing}</p><p>{t.storage}</p></>}
    {kind==='contact' && <><p>{t.contactBody}</p>{CONTACT_EMAIL ? <p><a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p> : <p><strong>PUBLIC_CONTACT_EMAIL</strong></p>}</>}
  </div>
</BaseLayout>
