# Required at production build time
SITE_URL=https://your-domain.example

# Branding / contact
PUBLIC_SITE_NAME=Utility Platform
PUBLIC_CONTACT_EMAIL=

# Optional Google AdSense. Leave empty to render non-network placeholders only.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=

# Optional privacy-friendly analytics. Example: your-domain.example
PUBLIC_PLAUSIBLE_DOMAIN=
